DOUBAO_ICL_TTS_RESOURCE_ID=seed-icl-2.0
DOUBAO_ICL_LANGUAGE=en
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
# Optional public WebSocket URL. The browser otherwise uses the same host and path.
