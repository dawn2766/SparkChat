# Realtime API uses the legacy APP ID + Access Token headers.
DOUBAO_SPEECH_APP_ID=
DOUBAO_SPEECH_ACCESS_KEY=
ARK_API_KEY=your_volcengine_ark_api_key
ARK_MODEL=doubao-seed-2-1-pro-260628
FLASK_SECRET_KEY=replace_with_a_long_random_value

SPEECH_ENGINE_PORT=3001
CLIENT_PORT=3002
CLIENT_HOST=127.0.0.1
COOKIE_SECURE=false

# Leave empty when using an existing Voice Clone 2.0 resource.
